# Execução local com dados sintéticos. Copie para .env se necessário.
ELO_API_PORT=8001
ELO_WEB_PORT=5173

# Opcional: identidades locais de teste. Sem arquivo, o modo demonstrativo
# mantém responsáveis autodeclarados. Provedor corporativo ainda a definir.
# ELO_AUTH_USERS_FILE=.local/users.json

# OpenAI para dossiês e assistente. Insira a chave somente no .env local.
# Sem chave, a síntese local continua disponível; não há fallback para Apple.
ELO_AI_PROVIDER=openai
OPENAI_API_KEY=
ELO_MODEL=gpt-6.2-sol
# Para Apple: ELO_AI_PROVIDER=apple e npm run setup:ai.
# auto preserva a detecção antiga (Apple tem prioridade).

# Escopo de execução: apenas local/test. Produção não é suportada nesta versão.
ELO_ENV=local
# 1 impede iniciar sem contas locais válidas; não equivale a SSO/MFA.
ELO_REQUIRE_AUTH=0
